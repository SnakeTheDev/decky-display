{
  "name": "decky-display",
  "version": "0.1.0",
  "description": "Use the Steam Deck's screen as a display for another machine",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python -m unittest discover -s tests -t ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filesfor/decky-display.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "display",
    "second-screen",
    "capture"
  ],
  "author": "filesfor",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}